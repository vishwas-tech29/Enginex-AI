APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/enginex
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=enginex-files
S3_REGION=us-east-1

JWT_SECRET=change-me-in-local-env-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:3000

# --- AI providers (all optional — the router falls back to a fake, no-key
# provider when none are set, so the app runs fine without any of these) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OLLAMA_BASE_URL=http://localhost:11434/v1

AI_PRIMARY_PROVIDER=anthropic
AI_FALLBACK_PROVIDERS=openai,gemini
AI_DEFAULT_MODEL=claude-3-5-sonnet-latest
AI_CLASSIFIER_MODEL=claude-3-5-haiku-latest
AI_MAX_DAILY_COST_USD=10.0

# ":memory:" needs no running server — good for local dev. Point at a real
# Qdrant instance (see docker-compose.yml) so indexed knowledge survives a
# restart.
QDRANT_URL=:memory:
EMBEDDING_DIMENSIONS=256

FRONTEND_URL=http://localhost:3000
LANDING_URL=http://localhost:5173

# --- Stripe (optional — billing endpoints return 503 "not configured"
# rather than crashing when these are unset) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_HOBBYIST_MONTHLY=
STRIPE_PRICE_HOBBYIST_ANNUAL=
STRIPE_PRICE_PROFESSIONAL_MONTHLY=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=

# --- Email (optional SMTP — unset means EmailService logs instead of
# sending, so local dev never needs a real mail server) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@velorah.io
SMTP_FROM_NAME=Velorah
